# US.T Root .gitignore

# ==========================================
# 1. Datasets and Large Files (数据与大文件)
# ==========================================
# Ignore all raw data directories at any level
data/
!hamer_tactile_ft/data/
!hamer_tactile_ft/data/*.py
_DATA/
datasets/
preprocessed_data/
final_annotations/
example_data/
example_data/downloaded*
hamer_training_data/
EgoTouch/

# Specific archive formats
*.tar
*.tar.gz
*.zip
*.rar
*.7z
*.part
final_annotation.zip
hamer_demo_data.tar.gz*

# HDF5 / Data tables / Large NumPy arrays
*.h5
*.hdf5
*.npy
*.npz
*.csv
!split.json
cfzhao.pem
# Image and Video visualizations (visual exports)
*.mp4
*.gif
*.png
*.jpg
*.jpeg
*.bmp
*.tiff
*.webp

# ==========================================
# 2. Model Weights & Checkpoints (权重与 Checkpoints)
# ==========================================
# Exclude any folder named checkpoints or checkpoint anywhere in the repo
**/checkpoints/
**/checkpoint/
**/ckpt/
weights/
lightning_logs/
logs/
logs*/
results/
outputs/
demo_out/
demo_output/
out_demo_video/
hamer_tactile_ft/full_bboxes_cache

# Model files
*.ckpt
*.pt
*.pth
*.pkl
!**/README.md  # Allow documentation inside weight folders if any

# MANO template files
**/MANO_RIGHT.pkl
**/MANO_LEFT.pkl
preprocess/scratch/MANO_RIGHT.pkl
preprocess/scratch/MANO_LEFT.pkl
hot3d/mano_v1_2/

# ==========================================
# 3. Environment & Package Managers (虚拟环境与安装包缓存)
# ==========================================
.env
.env.local
.envrc
.venv/
venv/
env/
ENV/
*.egg-info/
.pdm-build/
.pdm-python
.pixi/
build/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
__pypackages__/

# ==========================================
# 4. Compiles, Caches & Logs (编译、缓存与日志)
# ==========================================
__pycache__/
*.py[codz]
*$py.class
*.so
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.log
worker_crash_dump_*.txt

# Tool specific caches
.idea/
.vscode/
.claude/
.cursorignore
.cursorindexingignore
.DS_Store
*.spec
*.manifest
*.lock
wandb/

# others
hamer_tactile_ft/eval_reports
hamer_tactile_ft/eval_reports_*
hamer_tactile_ft/eval_reports_baseline
hamer_tactile_ft/data_integrity_audits/
hamer_tactile_ft/index_cache
hamer_tactile_ft/hdf5_manifest_cache
hamer_tactile_ft/reports
hamer_tactile_ft/amp_audits
hamer_tactile_ft/memorization
hamer_tactile_ft/run_processes/
hamer_tactile_ft/preflight_logs/
hamer_tactile_ft/input_prior_audits/
tactile_input_priors/outputs/
tactile_input_priors/cache/
tactile_input_priors/sidecars/
tactile_input_priors/models/
tactile_input_priors/envs/
tactile_input_priors/runtime_debug